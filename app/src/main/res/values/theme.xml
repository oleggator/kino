<?xml version="1.0" encoding="utf-8"?>
<!-- The UI is Compose; this is only the window theme, and it exists for one reason:
     windowBackground is what the TV paints before Compose's first frame, so without
     it the app opens on a white flash. The two colours are here rather than in a
     colors.xml because banner.xml references them too. -->
<resources>

    <color name="kino_bg">#10151C</color>
    <color name="kino_accent">#3DDC84</color>

    <style name="Kino" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/kino_accent</item>
        <item name="android:colorBackground">@color/kino_bg</item>
        <item name="android:windowBackground">@color/kino_bg</item>
    </style>

    <style name="Kino.Player" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

</resources>
